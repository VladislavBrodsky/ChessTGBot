# COMPLETE RAILWAY BACKEND VARIABLE REFERENCE (api.web3chess.online).
# Covers every Settings field and additional runtime controls in backend/app/.
# Values below are source defaults/examples, NOT an export of live Railway values.
# Credentials/references are intentionally blank in this shareable reference.
# The owning Railway account has been verified; preserve its existing live values.
# Do not bulk-import this reference over an existing service's variables.
# The backend loads .env locally; Railway supplies production variables directly.
ENV=production
TESTING=false

# Identity and API routing: normally retain the code defaults.
PROJECT_NAME="Chess Mini App"
# VERSION=1.7.3
API_V1_STR=/api/v1

# DATABASE AND CACHE — required Railway references, never localhost or SQLite.
# In Railway use ${{YOUR_POSTGRES_SERVICE.DATABASE_URL}} and
# ${{YOUR_REDIS_SERVICE.REDIS_URL}} with the actual service names.
# postgres:// and postgresql:// are normalized to the asyncpg driver.
DATABASE_URL=
REDIS_URL=
# Optional read replica. Omit unless configured; the primary is the default.
# DATABASE_READ_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# PUBLIC URLS AND CORS — exact origins separated by commas, not JSON or '*'.
WEBAPP_URL=https://app.web3chess.online
BACKEND_URL=https://api.web3chess.online
CORS_ALLOWED_ORIGINS=https://app.web3chess.online,https://web3chess.online,https://www.web3chess.online,https://web.telegram.org,https://telegram.org

# MAIN CHESS BOT — required existing credential, separate from marketing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=chess_matbot
# Existing administrator IDs, positive and comma-separated; no production fallback.
ADMIN_TELEGRAM_IDS=
# Legacy alternatives only; prefer the canonical variables above.
# ADMIN_TELEGRAM_ID=123456789
# The live backend currently uses the supported BOT_TOKEN alias for the chess bot.
# BOT_TOKEN=
# These two menu controls are read from process variables, not Settings/.env.
TELEGRAM_MENU_BUTTON_TEXT="Play Now"
USE_BOTFATHER_MENU_BUTTON=false

# SECURITY — required existing independent random secrets.
# Preserve existing production secrets; changing them may invalidate sessions.
SECRET_KEY=
WEBHOOK_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=11520
TRUSTED_PROXY_CIDRS=100.0.0.0/8

# GAMIFICATION AND ARENA — confirmed quest flag; other values are code defaults.
# Mystery Boxes contain virtual rewards only; no TON prize or financial requirement.
ENGAGEMENT_CAMPAIGN_ENABLED=true
ARENA_START_UTC="02:00, 08:00, 14:00, 20:00"
ARENA_DURATION_MINUTES=30
# AI worker count is a process variable; tune to the service's available memory.
AI_WORKER_POOL_SIZE=2

# REFERRALS AND ACCOUNT-FARMING CONTROLS — code defaults, retain live policy.
REFERRAL_SIGNUP_BONUS_DAILY_CAP=5
REFERRAL_MILESTONE_MIN_MOVES=10
SIGNUP_IP_CLUSTER_ALERT_THRESHOLD=5

# TON PROVIDER AND WALLET ADDRESSES — retain verified production values.
# TON_API_KEY is the TonAPI bearer key used by on-chain services.
TON_API_KEY=
# Legacy status indicator only; it does not replace TON_API_KEY.
TON_CONSOLE_TOKEN=
# Fill addresses from the verified production setup, not example wallet strings.
MASTER_WALLET_ADDRESS=
COMPANY_WALLET_ADDRESS=
# Jetton masters: retain the deployed values; not required for the virtual quest.
# USDT_MASTER=
# USDC_MASTER=
# BTC_MASTER=
# ETH_MASTER=

# PAYOUTS — preserve the existing funded production policy.
# Live production currently has payouts enabled; this inactive example is not
# the live policy. Keep the existing Railway value when comparing settings.
# The code default is false. Do not enable until the real wallet is verified.
PAYOUTS_ENABLED=false
# Required only for real payouts/gas grants; never copy into frontend variables.
PAYOUT_MNEMONIC=
WITHDRAWAL_DAILY_CAP_CENTS=100000
WITHDRAWAL_REVIEW_THRESHOLD_CENTS=50000
WITHDRAWAL_CONFIRMATION_ENABLED=true
WITHDRAWAL_CONFIRMATION_TTL_SECONDS=1800

# GAS GRANTS — existing production policy must be checked before changing this.
# Live production currently inherits true; false is the inactive example here.
GAS_GRANT_ENABLED=false
GAS_GRANT_AMOUNT_NANOTON=60000000
GAS_GRANT_MIN_USDT_UNITS=5000000
GAS_GRANT_MAX_TON_BALANCE_NANO=30000000
GAS_GRANT_COOLDOWN_DAYS=30
GAS_GRANT_DAILY_GLOBAL_CAP=25

# WALLET MONITORING — example is inactive until wallet values are verified.
# Live production inherits true for both flags, despite older code comments.
SOLVENCY_ALERTS_ENABLED=false
SOLVENCY_DEFICIT_BUFFER_CENTS=5000
SOLVENCY_CHECK_INTERVAL_SECONDS=3600
SOLVENCY_SUSTAINED_CHECKS=3
GAS_FLOAT_ALERTS_ENABLED=false
GAS_FLOAT_MIN_TON=2.0
GAS_FLOAT_CHECK_INTERVAL_SECONDS=3600

# STRIPE — optional, required only when the subscription integration is used.
# Preserve the active Stripe account's secret, webhook secret and price IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_MONTHLY_PRICE_ID=
# STRIPE_ANNUAL_PRICE_ID=

# TELEMETRY RETENTION — code defaults.
TELEMETRY_RAW_RETENTION_DAYS=30
TELEMETRY_MAINTENANCE_HOUR_UTC=2

# MARKETING PUBLISHER — configure in the publishing process, not the game client.
# See ../marketing/.env.production.example for the dedicated marketing bot.
# W3_TG_BOT_TOKEN=
# W3_TG_CHANNEL=@chess_hub

# RAILWAY-MANAGED METADATA — injected by Railway; do not fill manually.
# PORT
# RAILWAY_PROJECT_NAME
# RAILWAY_ENVIRONMENT_NAME
# RAILWAY_SERVICE_NAME
# RAILWAY_GIT_BRANCH
# PYTHONUNBUFFERED and PYTHONDONTWRITEBYTECODE are set by backend/Dockerfile.
