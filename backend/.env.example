# Database URL (Default for development SQLite)
DATABASE_URL=sqlite+aiosqlite:///chess.db

# Redis connection string (leave blank/commented for in-memory dev mode)
# REDIS_URL=redis://localhost:6379/0

# Telegram Bot configurations
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here

# Admin Telegram IDs (comma-separated list)
ADMIN_TELEGRAM_IDS=1016749901,716720099

# Legacy single admin ID (supported as fallback)
# ADMIN_TELEGRAM_ID=0

# Secret keys for signing/hashing
SECRET_KEY=your_secure_development_secret_key_here
WEBHOOK_SECRET=your_secure_webhook_secret_here

# Third-party integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TON_API_KEY=
TON_CONSOLE_TOKEN=

# Cross-chain BTC/ETH -> USDT on TON conversion (disabled until partner keys
# are configured and a live memo-preservation test has passed).
CROSS_CHAIN_DEPOSITS_ENABLED=false
CHANGELLY_API_URL=https://api.changelly.com/v2
CHANGELLY_API_KEY=
CHANGELLY_PRIVATE_KEY_HEX=
CHANGELLY_PAYOUT_CURRENCY=usdton
