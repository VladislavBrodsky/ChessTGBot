# LOCAL DEVELOPMENT ONLY. Copy to backend/.env and start the API from backend/.
# Railway production uses service variables; see .env.production.example.
# Never commit .env or paste credentials into screenshots/chat.
ENV=development
TESTING=false

# SQLite keeps local setup simple. For Postgres parity, start docker-compose.yml
# and replace DATABASE_URL with the commented connection string.
DATABASE_URL=sqlite+aiosqlite:///./chess.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chess_db
# Redis defaults to this address even if omitted. A blank URL is not memory mode.
# The application falls back to process-local storage if Redis is unavailable.
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Local client and API. CORS_ALLOWED_ORIGINS is a comma-separated string.
# BACKEND_CORS_ORIGINS is not a recognized setting.
WEBAPP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3124,http://127.0.0.1:3124

# Chess bot: leave the token empty unless using a dedicated development bot.
# Local polling with the production chess token would disrupt its webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=chess_matbot
# Optional local admin override: positive Telegram IDs separated by commas.
# Production requires explicit administrator IDs and has no fallback identities.
# ADMIN_TELEGRAM_IDS=

# Dedicated marketing bot (@Web3chess_bot), separate from the chess bot.
# Give it Post Messages permission in @chess_hub. channel.py reads this file
# only when --env-file backend/.env is supplied from the repository root.
W3_TG_BOT_TOKEN=
W3_TG_CHANNEL=@chess_hub

# Generate TWO independent values before starting:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
WEBHOOK_SECRET=

# First Three: virtual rewards only. False pauses enrollment, not earned claims.
ENGAGEMENT_CAMPAIGN_ENABLED=true

# Disable live money operations and wallet monitoring during local development.
PAYOUTS_ENABLED=false
WITHDRAWAL_CONFIRMATION_ENABLED=true
GAS_GRANT_ENABLED=false
SOLVENCY_ALERTS_ENABLED=false
GAS_FLOAT_ALERTS_ENABLED=false

# Optional provider credentials. Leave unused integrations empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TON_API_KEY=
# Reserved legacy setting; on-chain services currently use TON_API_KEY.
TON_CONSOLE_TOKEN=
