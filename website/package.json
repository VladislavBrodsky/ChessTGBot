{
  "name": "web3chess-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:check && npm run ui:check && next build --webpack && npm run ui:check -- --compiled",
    "content:check": "node scripts/check-content.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs",
    "brand:build": "node scripts/build-brand.mjs",
    "audit:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "audit:lighthouse:desktop": "lhci autorun --config=./lighthouserc.desktop.json",
    "ui:check": "node scripts/check-ui.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "cobe": "^2.0.1",
    "framer-motion": "^12.43.0",
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-chessboard": "5.12.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.14.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.16",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "Chrome >= 109",
    "Firefox >= 109",
    "Safari >= 16",
    "Edge >= 109",
    "iOS >= 16",
    "not dead"
  ]
}
