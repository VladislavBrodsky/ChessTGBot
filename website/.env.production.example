# RAILWAY MARKETING WEBSITE VARIABLES (web3chess.online).
# Public values are baked into next build; redeploy after changing them.
# These are source domain/link defaults, not an export of live Railway values.
# No backend credentials or bot tokens belong in this service.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

NEXT_PUBLIC_SITE_URL=https://web3chess.online
NEXT_PUBLIC_APP_URL=https://app.web3chess.online
NEXT_PUBLIC_BOT_USERNAME=chess_matbot
NEXT_PUBLIC_TELEGRAM_CHANNEL=https://t.me/chess_hub
NEXT_PUBLIC_TELEGRAM_CHAT=https://t.me/chesshub_chat

# Optional: existing Google Search Console verification string, not an API key.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Website build context is the repository root, because it imports shared tokens.
RAILWAY_DOCKERFILE_PATH=website/Dockerfile
# PORT is supplied by Railway; the Dockerfile sets HOSTNAME=0.0.0.0.
