# RAILWAY MINI APP VARIABLES (app.web3chess.online).
# Public values are baked into next build; redeploy after changing them.
# These are source domain defaults, not an export of the current Railway service.
# Never put a bot token, signing secret, database password or mnemonic here.
NODE_ENV=production
STATIC_EXPORT=false
NEXT_TELEMETRY_DISABLED=1

# BACKEND_URL drives the server's /api and /socket.io rewrites at build time.
BACKEND_URL=https://api.web3chess.online
NEXT_PUBLIC_API_URL=https://api.web3chess.online
NEXT_PUBLIC_BOT_USERNAME=chess_matbot

# Optional browser error reporting; use the existing project's public Sentry DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Development-only identities must stay disabled in production.
NEXT_PUBLIC_E2E_TEST_MODE=false
NEXT_PUBLIC_E2E_AUTO_AUTH=false

# PORT is supplied by Railway; start-server.mjs sets HOSTNAME=0.0.0.0.
# Build context/root directory: frontend (Dockerfile path: Dockerfile).
# If using a root build context instead, configure that separately; do not guess.
# The old NEXT_PUBLIC_TRANSAK_* and NEXT_PUBLIC_SELF_CUSTODY_BRIDGE_ENABLED
# entries in .env.development are not consumed by the current source code.
