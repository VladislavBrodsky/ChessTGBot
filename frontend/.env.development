NEXT_PUBLIC_API_URL=

# Transak fiat on-ramp (Card / Apple Pay / Google Pay deposits).
# Leave the API key blank to hide the "Card" tab in the deposit modal.
# For local testing, set these in a git-ignored .env.local (do NOT commit real keys):
#   NEXT_PUBLIC_TRANSAK_API_KEY=<your-transak-api-key>
#   NEXT_PUBLIC_TRANSAK_ENVIRONMENT=STAGING   # or PRODUCTION
NEXT_PUBLIC_TRANSAK_API_KEY=
NEXT_PUBLIC_TRANSAK_ENVIRONMENT=STAGING
