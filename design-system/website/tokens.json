{
  "$description": "Web3Chess website — Fog Board design tokens (W3C Design Tokens Community Group format). Source of truth for theme.css and tokens.ts. Spec: DESIGN.md. Dimensions are px strings for Style Dictionary compatibility; fluid values live in $extensions.fluid.",
  "color": {
    "$type": "color",
    "ink": { "$value": "#20294C", "$description": "Board Ink — headlines, body text, filled primary button, theme-color meta. 12.55:1 on fog." },
    "royal": { "$value": "#0A2D67", "$description": "Royal Ink — chip and nav-chip text, secondary-action hover borders. 12.70:1 on paper." },
    "steel": { "$value": "#375390", "$description": "Cornflower Steel — icon strokes, outline button border + text, draw state. 6.64:1 on fog." },
    "hyacinth": { "$value": "#788DBA", "$description": "Borders (50% alpha on chips) and Fog Board dark squares. Never text on light (2.95:1)." },
    "dusk": { "$value": "#676B89", "$description": "Secondary text on fog (4.60), white (5.20) or paper (4.98). Never on mist (3.91)." },
    "smoke": { "$value": "#979DB5", "$description": "Secondary text on night (6.62) or ink (5.26) only. Never text on light (2.38)." },
    "silver": { "$value": "#C7CBDB", "$description": "Hairline borders, dividers, nav-chip border; secondary text on ink band." },
    "mist": { "$value": "#DDDFE9", "$description": "Washes, nested fills, QR dock (50%), Fog Board light squares." },
    "fog": { "$value": "#F0F1F5", "$description": "Page canvas, inset chip fill." },
    "paper": { "$value": "#FAFAFA", "$description": "Feature chip and beta badge fill." },
    "white": { "$value": "#FFFFFF", "$description": "Card surface; text on ink (14.16) and night (17.80)." },
    "abyss": { "$value": "#042939", "$description": "Text on voltage (14.16); darkest illustration frame." },
    "night": { "$value": "#071A22", "$description": "Night panel ground (with grain) — the Mini App bridge." },
    "night-raised": { "$value": "#103645", "$description": "Raised element on night; white text 12.84." },
    "signal": { "$value": "#459AF8", "$description": "Electric blue — accent dots, active marks, one Signal tile (ink text 4.88). NOT text on light (2.57)." },
    "signal-ink": { "$value": "#1A63BF", "$description": "Link text on light: 5.20 fog, 5.86 white, 5.62 paper. Not on mist (4.41)." },
    "signal-soft": { "$value": "#7DB8FA", "$description": "Link text on night (8.57) and ink." },
    "voltage": { "$value": "#FFFF00", "$description": "One moment per page. Abyss or ink text only." },
    "king": { "$value": "#FFD700", "$description": "Logo king glyph only (10.10 on ink). Carried over from frontend/public/icon.svg." },
    "win": { "$value": "#047857", "$description": "Win / positive delta text on light (4.86 fog)." },
    "win-fill": { "$value": "#10B981", "$description": "Win fill; ink text 5.58. Same emerald as the Mini App." },
    "win-soft": { "$value": "#34D399", "$description": "Win text on night (9.26)." },
    "loss": { "$value": "#BE123C", "$description": "Loss / negative delta text on light (5.57 fog)." },
    "loss-fill": { "$value": "#E11D48", "$description": "Live dot, loss fill; white text 4.70 on white-adjacent use only with ≥24px." },
    "loss-soft": { "$value": "#FB7185", "$description": "Loss text on night (6.61)." },
    "premium": { "$value": "#6D28D9", "$description": "Premium badge text on light (6.29 fog); white on fill 7.10." },
    "premium-soft": { "$value": "#A78BFA", "$description": "Premium text on night (6.54)." },
    "caution": { "$value": "#92400E", "$description": "Caution / region notice text on light (6.28 fog)." },
    "caution-soft": { "$value": "#FBBF24", "$description": "Caution on night; clock low-time accent." }
  },
  "surface": {
    "$description": "Semantic roles per surface scope. `canvas` is default; others apply via data-surface.",
    "canvas": {
      "$type": "color",
      "ground": { "$value": "{color.fog}" },
      "card": { "$value": "{color.white}" },
      "inset": { "$value": "{color.fog}" },
      "wash": { "$value": "{color.mist}" },
      "chip": { "$value": "{color.paper}" },
      "fg": { "$value": "{color.ink}" },
      "fg-muted": { "$value": "{color.dusk}" },
      "fg-action": { "$value": "{color.royal}" },
      "fg-link": { "$value": "{color.signal-ink}" },
      "line": { "$value": "{color.silver}" },
      "line-strong": { "$value": "{color.steel}" },
      "icon": { "$value": "{color.steel}" },
      "focus": { "$value": "{color.signal-ink}" }
    },
    "ink": {
      "$type": "color",
      "ground": { "$value": "{color.ink}" },
      "fg": { "$value": "{color.white}" },
      "fg-muted": { "$value": "{color.silver}" },
      "fg-link": { "$value": "{color.signal-soft}" },
      "icon": { "$value": "{color.smoke}" },
      "focus": { "$value": "{color.signal-soft}" }
    },
    "night": {
      "$type": "color",
      "ground": { "$value": "{color.night}" },
      "card": { "$value": "{color.night-raised}" },
      "fg": { "$value": "{color.white}" },
      "fg-muted": { "$value": "{color.smoke}" },
      "fg-link": { "$value": "{color.signal-soft}" },
      "icon": { "$value": "{color.smoke}" },
      "focus": { "$value": "{color.signal-soft}" }
    },
    "voltage": {
      "$type": "color",
      "ground": { "$value": "{color.voltage}" },
      "fg": { "$value": "{color.abyss}" },
      "focus": { "$value": "{color.abyss}" }
    },
    "signal": {
      "$type": "color",
      "ground": { "$value": "{color.signal}" },
      "fg": { "$value": "{color.ink}" },
      "focus": { "$value": "{color.ink}" }
    }
  },
  "board": {
    "$type": "color",
    "$description": "Fog Board chessboard theme for website widgets (react-chessboard square styles).",
    "square-light": { "$value": "#DDDFE9" },
    "square-dark": { "$value": "#788DBA" },
    "coordinate-on-light": { "$value": "#0A2D67" },
    "coordinate-on-dark": { "$value": "#FFFFFF" },
    "last-move": { "$value": "rgba(255, 255, 0, 0.45)" },
    "selected": { "$value": "rgba(69, 154, 248, 0.35)" },
    "move-hint": { "$value": "rgba(32, 41, 76, 0.22)" },
    "check": { "$value": "rgba(225, 29, 72, 0.6)" },
    "piece-white-fill": { "$value": "#FFFFFF" },
    "piece-white-stroke": { "$value": "#20294C" },
    "piece-black-fill": { "$value": "#20294C" },
    "piece-black-stroke": { "$value": "#F0F1F5" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Onest", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Noto Sans SC", "Noto Sans JP", "Noto Sans Devanagari", "Noto Sans Arabic", "sans-serif"],
        "$description": "All UI and headlines. Free substitute (Latin + Cyrillic) for licensed GT Walsheim Pro.",
        "$extensions": { "licensed": "GT Walsheim Pro", "weights": [400, 600, 700] }
      },
      "accent": {
        "$value": ["Golos Text", "Onest", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Neo-grotesque accent for stats and pull quotes only. Free substitute for GT America.",
        "$extensions": { "licensed": "GT America", "weights": [400, 500] }
      },
      "mono": {
        "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"],
        "$description": "Chess notation, clocks, ratings in tables, TON addresses, tx hashes.",
        "$extensions": { "weights": [400, 500, 600] }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "100px", "fontWeight": 700, "lineHeight": 0.85, "letterSpacing": "-0.03em" }, "$extensions": { "fluid": { "min": "56px", "max": "100px", "clamp": "clamp(3.5rem, 2.36rem + 4.86vw, 6.25rem)" } } },
    "heading-xl": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "64px", "fontWeight": 700, "lineHeight": 1, "letterSpacing": "-0.03em" }, "$extensions": { "fluid": { "min": "40px", "max": "64px", "clamp": "clamp(2.5rem, 1.88rem + 2.65vw, 4rem)" } } },
    "heading-lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "48px", "fontWeight": 700, "lineHeight": 1.08, "letterSpacing": "-0.03em" }, "$extensions": { "fluid": { "min": "34px", "max": "48px", "clamp": "clamp(2.125rem, 1.76rem + 1.55vw, 3rem)" } } },
    "heading-md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "32px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.03em" }, "$extensions": { "fluid": { "min": "26px", "max": "32px", "clamp": "clamp(1.625rem, 1.47rem + 0.66vw, 2rem)" } } },
    "heading-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "24px", "fontWeight": 600, "lineHeight": 1.5, "letterSpacing": "-0.03em" }, "$extensions": { "fluid": { "min": "22px", "max": "24px", "clamp": "clamp(1.375rem, 1.32rem + 0.22vw, 1.5rem)" } } },
    "stat": { "$value": { "fontFamily": "{font.family.accent}", "fontSize": "42px", "fontWeight": 500, "lineHeight": 1, "letterSpacing": "-0.02em" }, "$extensions": { "fluid": { "min": "32px", "max": "42px", "clamp": "clamp(2rem, 1.74rem + 1.1vw, 2.625rem)" } } },
    "lead": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "24px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0em" }, "$extensions": { "fluid": { "min": "20px", "max": "24px", "clamp": "clamp(1.25rem, 1.15rem + 0.44vw, 1.5rem)" } } },
    "title": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.5, "letterSpacing": "-0.01em" } },
    "chip": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "18px", "fontWeight": 600, "lineHeight": 1.33, "letterSpacing": "0em" } },
    "body-lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "18px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0em" } },
    "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "17px", "fontWeight": 400, "lineHeight": 1.41, "letterSpacing": "0em" } },
    "body-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0em" } },
    "label": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "fontWeight": 600, "lineHeight": 1.43, "letterSpacing": "0.01em" } },
    "caption": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.43, "letterSpacing": "0em" } },
    "overline": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "0.08em" }, "$description": "Uppercase. Tracking resets to 0 for zh/ja/hi/ar." },
    "button-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "15px", "fontWeight": 600, "lineHeight": 1.33, "letterSpacing": "0em" } },
    "button": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "17px", "fontWeight": 600, "lineHeight": 1.41, "letterSpacing": "0em" } },
    "button-lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "0em" } },
    "notation": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "15px", "fontWeight": 500, "lineHeight": 1.6, "letterSpacing": "0em" } },
    "clock": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "28px", "fontWeight": 600, "lineHeight": 1, "letterSpacing": "-0.01em" } }
  },
  "space": {
    "$type": "dimension",
    "2xs": { "$value": "4px" },
    "xs": { "$value": "8px", "$description": "Base unit; element gap." },
    "sm": { "$value": "12px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "24px", "$description": "Card padding." },
    "xl": { "$value": "32px" },
    "2xl": { "$value": "48px", "$description": "Measured Fold section top padding." },
    "3xl": { "$value": "64px" },
    "4xl": { "$value": "96px" },
    "5xl": { "$value": "120px" },
    "6xl": { "$value": "160px" },
    "gutter": { "$value": "48px", "$extensions": { "fluid": { "min": "24px", "max": "48px", "clamp": "clamp(1.5rem, 0.88rem + 2.65vw, 3rem)" } } },
    "section": { "$value": "120px", "$extensions": { "fluid": { "min": "64px", "max": "120px", "clamp": "clamp(4rem, 2.55rem + 6.19vw, 7.5rem)" } } },
    "card": { "$value": "24px" },
    "panel": { "$value": "48px", "$extensions": { "fluid": { "min": "24px", "max": "48px", "clamp": "clamp(1.5rem, 0.88rem + 2.65vw, 3rem)" } } }
  },
  "container": {
    "$type": "dimension",
    "prose": { "$value": "640px" },
    "content": { "$value": "928px" },
    "main": { "$value": "1024px" },
    "wide": { "$value": "1200px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "8px", "$description": "Nav chips, icon buttons, inputs, tooltips." },
    "card": { "$value": "12px", "$description": "Cards, QR dock, board frame." },
    "media": { "$value": "16px", "$description": "Images, screenshots, video." },
    "device": { "$value": "20px", "$description": "Screen inside a device frame." },
    "panel": { "$value": "24px", "$description": "Bento tiles, bands, modals, sticky nav pill." },
    "frame": { "$value": "40px", "$description": "Device outer frame." },
    "pill": { "$value": "9999px", "$description": "Buttons, chips, badges, toggles." }
  },
  "shadow": {
    "$type": "shadow",
    "control": { "$value": [{ "color": "rgba(32, 41, 76, 0.10)", "offsetX": "0px", "offsetY": "1px", "blur": "4px", "spread": "0px" }] },
    "hairline": { "$value": [{ "color": "rgba(32, 41, 76, 0.04)", "offsetX": "0px", "offsetY": "1px", "blur": "4px", "spread": "0px" }] },
    "nested": { "$value": [
      { "color": "rgba(32, 41, 76, 0.07)", "offsetX": "0px", "offsetY": "4px", "blur": "11px", "spread": "0px" },
      { "color": "rgba(32, 41, 76, 0.12)", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }
    ] },
    "float": { "$value": [
      { "color": "rgba(32, 41, 76, 0.12)", "offsetX": "0px", "offsetY": "6px", "blur": "16px", "spread": "0px" },
      { "color": "rgba(32, 41, 76, 0.09)", "offsetX": "0px", "offsetY": "1px", "blur": "5px", "spread": "0px" }
    ] },
    "card": { "$value": [{ "color": "rgba(32, 41, 76, 0.12)", "offsetX": "0px", "offsetY": "9px", "blur": "25px", "spread": "0px" }] },
    "edge": { "$value": [{ "color": "rgba(255, 255, 255, 0.53)", "offsetX": "0px", "offsetY": "1px", "blur": "0px", "spread": "0px" }] },
    "well": { "$value": [{ "color": "rgba(32, 41, 76, 0.05)", "offsetX": "0px", "offsetY": "0px", "blur": "4px", "spread": "0px", "inset": true }] }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": "75ms", "$description": "Tittle pop, press feedback." },
    "fast": { "$value": "100ms", "$description": "Link underline." },
    "base": { "$value": "150ms", "$description": "Color, border, shadow transitions." },
    "medium": { "$value": "200ms", "$description": "Mockup theme cross-fade, tooltips." },
    "slow": { "$value": "500ms", "$description": "Mockup transforms, sheet open." },
    "reveal": { "$value": "640ms", "$description": "Section reveal." }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.4, 0, 0.2, 1] },
    "pop": { "$value": [0.06, 0.94, 0.67, 1.01] },
    "enter": { "$value": [0.2, 0, 0, 1] },
    "exit": { "$value": [0.4, 0, 1, 1] }
  },
  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "sticky": { "$value": 40, "$description": "Sticky nav pill, mobile CTA bar." },
    "dock": { "$value": 50, "$description": "QR dock (measured z-50)." },
    "dropdown": { "$value": 60 },
    "overlay": { "$value": 100 },
    "modal": { "$value": 110 },
    "toast": { "$value": 140 }
  }
}
