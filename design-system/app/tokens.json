{
  "$comment": "Single source of truth for Mini App scale tokens. Edit here, then run `npm run tokens` in frontend/. Colours live in frontend/src/styles/themes.css (per theme). Never hand-edit src/styles/tokens.css.",
  "type": {
    "$doc": "Role-based type scale (Outfit Variable, native fallbacks). Minimum rendered size is 12px. Numerals use tabular figures.",
    "display":   { "size": "2.5rem",                         "leading": 1.1,  "weight": 700, "tracking": "-0.04em",  "use": "Hero figures and welcome headlines" },
    "title-1":   { "size": "clamp(1.75rem, 1.4rem + 1.2vw, 2rem)", "leading": 1.15, "weight": 700, "tracking": "-0.035em", "use": "One per page: PageHeader title" },
    "title-2":   { "size": "1.25rem",                        "leading": 1.3,  "weight": 700, "tracking": "-0.02em",  "use": "Section headings (SectionHeader), sheet titles" },
    "title-3":   { "size": "1.0625rem",                      "leading": 1.35, "weight": 650, "tracking": "-0.01em",  "use": "Card and list-row titles" },
    "body-lg":   { "size": "1rem",                           "leading": 1.5,  "weight": 400, "tracking": "0",        "use": "Reading text, form input text (16px prevents iOS zoom)" },
    "body":      { "size": "0.875rem",                       "leading": 1.5,  "weight": 400, "tracking": "0",        "use": "Default UI copy and descriptions" },
    "label":     { "size": "0.875rem",                       "leading": 1.25, "weight": 650, "tracking": "0",        "use": "Buttons, tabs, controls" },
    "caption":   { "size": "0.75rem",                        "leading": 1.4,  "weight": 500, "tracking": "0",        "use": "Metadata, helper text, badges" },
    "eyebrow":   { "size": "0.75rem",                        "leading": 1.4,  "weight": 650, "tracking": "0.08em",   "use": "Micro-labels above values (uppercase in Latin/Cyrillic only)" },
    "numeric-xl":{ "size": "2.5rem",                         "leading": 1,    "weight": 700, "tracking": "-0.04em",  "use": "Balance, rating hero numbers" },
    "numeric-lg":{ "size": "1.75rem",                        "leading": 1.1,  "weight": 700, "tracking": "-0.03em",  "use": "Stat tile values" },
    "numeric":   { "size": "1.25rem",                        "leading": 1.2,  "weight": 700, "tracking": "-0.02em",  "use": "Inline key figures" },
    "numeric-sm":{ "size": "0.875rem",                       "leading": 1.2,  "weight": 650, "tracking": "0",        "use": "Prices, XP, scores inside rows" }
  },
  "space": {
    "$doc": "4px base grid. Use the named layout gaps for composition; raw steps for fine adjustment.",
    "0": "0", "0-5": "2px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px",
    "gap-inline": "8px", "gap-stack": "12px", "gap-card": "16px", "gap-section": "24px", "gap-page": "32px",
    "pad-sm": "12px", "pad-md": "16px", "pad-lg": "20px", "pad-xl": "24px"
  },
  "size": {
    "$doc": "Hit areas, icons, avatars and tiles. Every touch control is at least 44x44px.",
    "control-sm": "44px", "control-md": "48px", "control-lg": "56px", "control-compact": "36px",
    "icon-xs": "14px", "icon-sm": "16px", "icon-md": "20px", "icon-lg": "24px", "icon-xl": "32px",
    "avatar-xs": "24px", "avatar-sm": "32px", "avatar-md": "40px", "avatar-lg": "48px", "avatar-xl": "64px", "avatar-2xl": "96px",
    "tile-sm": "32px", "tile-md": "40px", "tile-lg": "48px", "tile-xl": "56px",
    "row-min": "64px", "stat-min": "96px", "goal-tile-min": "148px", "quick-tile-min": "108px", "nav-height": "68px",
    "chip": "26px", "chip-counter": "20px",
    "track-sm": "6px", "track-md": "8px", "track-lg": "12px",
    "ring-sm": "48px", "ring-md": "64px", "ring-lg": "96px"
  },
  "radius": {
    "$doc": "Radius follows nesting: an inner element is always at least one step smaller than its container.",
    "xs": "6px", "sm": "8px", "md": "12px", "lg": "16px", "xl": "20px", "2xl": "24px", "3xl": "28px", "pill": "999px",
    "chip": "8px", "control": "12px", "tile": "12px", "row": "16px", "card": "20px", "hero": "24px", "sheet": "28px"
  },
  "z": {
    "$doc": "Layer scale. Overlays use >= 100 so they always cover the navigation (z 50).",
    "base": "0", "content": "10", "sticky": "20", "nav": "50", "overlay": "100", "nested": "110", "critical": "120", "toast": "140"
  },
  "motion": {
    "$doc": "Interaction feedback 100-160ms; entrances 240-420ms; never block input. All collapse under reduced motion.",
    "duration-instant": "100ms", "duration-fast": "160ms", "duration-base": "240ms", "duration-slow": "420ms", "duration-chart": "700ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)", "ease-emphasized": "cubic-bezier(0.16, 1, 0.3, 1)", "ease-exit": "cubic-bezier(0.4, 0, 1, 1)"
  }
}
