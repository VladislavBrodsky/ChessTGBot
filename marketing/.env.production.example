# DEDICATED MARKETING PUBLISHER — separate from the main chess bot.
# Example only, not an export of existing production credentials.
# Store real credentials in the publisher's environment or an ignored .env.
# The single-post command supports --env-file; the daily pipeline uses process env.
W3_TG_BOT_TOKEN=
W3_TG_CHANNEL=@chess_hub

# Optional automated draft writer, used only by content-ops/pipeline/writer.py.
# Preserve the provider/model chosen for that process. Neither is a chess API need.
# ANTHROPIC_API_KEY=
# W3_WRITER_MODEL=

# Optional local render switch; renderer.py checks only whether it is nonempty.
# W3_FRONTEND_NODE_MODULES=1

# Academy generation scripts, run manually outside the deployed API, can use
# OPENAI_API_KEY= (never publish this as NEXT_PUBLIC_*).
